{
  "expo": {
    "name": "EMI Calculator",
    "slug": "emi-loan-calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "emicalc",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.aakashpatel.emicalculator",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#EFF4F7",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0C1116"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Loan EMI, amortisation, part payment, deposits, SIP and everyday calculators. Everything is worked out on the device.",
    "primaryColor": "#1E78AE",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0b42d16e-2ac9-46d1-a85c-2feae6f2052d"
      }
    },
    "owner": "itsaakashpatel",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0b42d16e-2ac9-46d1-a85c-2feae6f2052d"
    },
    "android": {}
  }
}
